/target
*.ppm
/evidence/

# Build/test artefacts from nested candidate crates and verification harnesses.
/experiments/*/target/
/verification/**/target/
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# Python bytecode produced by local validation scripts.
__pycache__/
*.py[cod]
/third_party/*/dist/
/third_party/*/target/

# Built platform bundles (macOS .app, iOS .app) are produced by the build scripts.
/macos/target/
/ios/target/

# Signing material never belongs in a public repository.
*.mobileprovision
*.p12
*.cer
*.cer.pem
ios/app/build/
ios/app/DerivedData/

# Xcode derived data and signing material.
ios/app/DerivedData/
